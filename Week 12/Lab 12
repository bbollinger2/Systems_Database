-- Why Primary and Foregin Keys matter?
-- In a relational database, data lives in multiple tables, but those tables must be connected somehow
-- We do this using keys

-- Primary Key(PK): A Column (Or set of columns) that uniquely identify a row in a table
--> student_id, customer_id, product_id

-- Foreign Key(FK): A column in one table that refuers to a PK in another table
--> A FK is just a PK in another table

-- Think of PK/FK like a parent-child relationship - a parent can have many children,
-- but each child points to one parent

-- Creating the parent table (Customers)
-- CREATE TABLE customers(
-- customer_id serial PRIMARY KEY,
-- "name" text,
-- email text,
-- city text);

-- Serial automatiacally numbers each new record
-- PRIMARY KEY ensures each id is unique and not null

-- Creating the Child Table (Orders)
-- CREATE TABLE orders(
-- id serial PRIMARY KEY,
-- customer_id int,
-- product text,
-- total numeric(10,2),
-- FOREIGN KEY(customer_id) REFERENCES customers(customer_id));

-- Customer_id linked each order back to a customer
-- The FK constrain prevents orphan records
-- (You can't create an order for a non-existing Customer)

